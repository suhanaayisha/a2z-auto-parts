{
  "name": "a2z-auto-parts-web",
  "version": "1.0.0",
  "private": true,
  "description": "A2Z Auto Parts web app (Next.js)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "PORT=3000 node --env-file-if-exists=../api/.env server.mjs",
    "build": "npm ci --prefix ../api --omit=dev && next build",
    "start": "NODE_ENV=production node server.mjs"
  },
  "dependencies": {
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
