# Copy to api/.env for local development (npm run dev). On Render, set these in the dashboard.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=partsdesk
# Any random string of 32+ characters. Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# PORT=4000  (only used when running the API on its own; the whole app runs on 3000)
# Optional: turns on "Read message into items"
ANTHROPIC_API_KEY=

# WhatsApp intake (the wa/ service; run it with `cd wa && npm run dev`)
# Voice notes: OPENAI_API_KEY (Whisper) or DEEPGRAM_API_KEY
OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# WA_AUTO_CONFIDENCE=0.85   (or "off" to check everything by hand)
# WA_QUIET_SECONDS=90       wait this long after a chat's last message before reading it
# WA_MAX_WAIT_MINUTES=10    but no longer than this after its first
# WA_CHATS=all              ("groups" ignores direct chats)
